# Supabase Configuration (Required)
# Get these from: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_PROJECT_ID="your-project-id-here"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-public-key-here"

# Shopify Configuration (Required)
# Get these from: Shopify Admin → Apps → Create custom app or private app
VITE_SHOPIFY_STORE="your-store-name.myshopify.com"
VITE_SHOPIFY_STOREFRONT_TOKEN="your-storefront-access-token-here"

# hCaptcha Configuration (Optional - for form protection)
# Get these from: https://dashboard.hcaptcha.com/
# 1. Sign up and create a site
# 2. Add your domains: asperbeautyshop.lovable.app, localhost
# 3. Copy the Site Key (this goes in .env)
# 4. Copy the Secret Key (this goes in Supabase Secrets, not here)
VITE_HCAPTCHA_SITE_KEY="your-hcaptcha-site-key-here"

# Notes:
# - Never commit the actual .env file with real credentials
# - For production, set these in your hosting platform's environment variables
# - For Supabase Edge Functions, add server-side secrets (like HCAPTCHA_SECRET_KEY)
#   in Supabase Dashboard → Settings → Edge Functions → Secrets
