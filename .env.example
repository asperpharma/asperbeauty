# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
VITE_SUPABASE_PROJECT_ID=your-supabase-project-id

# Shopify Configuration
# Get these from your Shopify admin panel
VITE_SHOPIFY_STORE=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=your-storefront-access-token

# hCaptcha Configuration
# Get your keys from https://hcaptcha.com
# 1. Sign up at hcaptcha.com
# 2. Add your domain
# 3. Get your Site Key and Secret Key
VITE_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key-here

# Note: The following are server-side environment variables
# These should be configured in your Supabase Edge Functions secrets:
# - SUPABASE_SERVICE_ROLE_KEY
# - HCAPTCHA_SECRET_KEY
# - RESEND_API_KEY
# - LOVABLE_API_KEY
# - FIRECRAWL_API_KEY
