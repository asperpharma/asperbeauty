# Supabase Configuration
# Get your credentials from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Shopify Configuration
# Get your Storefront API token from: Shopify Admin > Apps > Develop apps
VITE_SHOPIFY_STORE="your-store.myshopify.com"
VITE_SHOPIFY_STOREFRONT_TOKEN="your-storefront-access-token"

# hCaptcha Configuration
# Get your keys from: https://hcaptcha.com
# 1. Sign up at hcaptcha.com
# 2. Add your domain(s) to the allowlist
# 3. Get your Site Key (client-side) and Secret Key (server-side)
VITE_HCAPTCHA_SITE_KEY="your-hcaptcha-site-key-here"

# Resend Email Configuration
# Get your API key from: https://resend.com/api-keys
# Note: This is ONLY used in Supabase Edge Functions (server-side)
# Add RESEND_API_KEY to your Supabase project secrets, NOT in this file
# Instructions: Supabase Dashboard > Project Settings > Edge Functions > Secrets
