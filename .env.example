# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com/project/rgehleqcubtmcwyipyvi/settings/api
VITE_SUPABASE_PROJECT_ID="rgehleqcubtmcwyipyvi"
VITE_SUPABASE_URL="https://rgehleqcubtmcwyipyvi.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key-here"

# Shopify Configuration
# Get your Storefront API token from Shopify Admin > Apps > Develop apps
VITE_SHOPIFY_STORE="your-store.myshopify.com"
VITE_SHOPIFY_STOREFRONT_TOKEN="your-shopify-storefront-token-here"

# hCaptcha Configuration
# Sign up at https://hcaptcha.com and get your Site Key
# Add your domains: asperbeautyshop.com and asperbeautyshop.lovable.app
VITE_HCAPTCHA_SITE_KEY="your-hcaptcha-site-key-here"

# Resend Email Configuration
# Get your API key from https://resend.com
# Note: This is only used in Supabase Edge Functions (server-side)
# Add RESEND_API_KEY to Supabase Secrets via: npx supabase secrets set RESEND_API_KEY=your-key
# Do NOT add it to this file
